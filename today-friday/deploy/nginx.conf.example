server {
    listen 443 ssl http2;
    server_name example.com;

    root /var/www/today-friday/public;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /api/create-payment {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/today-friday/api/create-payment.php;
        fastcgi_pass unix:/run/php/php7.4-fpm.sock;
    }

    location = /api/payment-status {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/today-friday/api/payment-status.php;
        fastcgi_pass unix:/run/php/php7.4-fpm.sock;
    }

    location = /api/result {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/today-friday/api/result.php;
        fastcgi_pass unix:/run/php/php7.4-fpm.sock;
    }

    location = /api/webhook {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/today-friday/api/webhook.php;
        fastcgi_pass unix:/run/php/php7.4-fpm.sock;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php7.4-fpm.sock;
    }
}
